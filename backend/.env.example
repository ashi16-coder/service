# ─────────────────────────────────────────────────────────────
# Tourism Support API — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ───────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:password@localhost:5432/tourism_db

# ── Auth (REQUIRED) ───────────────────────────────────────────
# Secret key used to sign JWT tokens — use a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_secret

# ── Weather API (OPTIONAL) ────────────────────────────────────
# OpenWeatherMap API key — app returns mock data if not set
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Translation API (OPTIONAL) ────────────────────────────────
# Google Cloud Translation API key — app returns mock data if not set
# Enable at: https://console.cloud.google.com/apis/library/translate.googleapis.com
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
